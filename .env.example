# ==============================================================
# Secure Camera Network Analytics - environment configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ==============================================================

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DATABASE_URL=sqlite:///./data/secure_camera_network.db

# --- Admin API key (used only for POST /camera/register) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=

# --- Camera node identity (used when running camera_node/client.py directly) ---
CAMERA_NODE_ID=CAM_001
CAMERA_SECRET=
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=10
FRAME_SKIP=2

# --- Encryption ---
# Generate with: python -c "from camera_node.encryption import generate_key; print(generate_key())"
AES_KEY=

# --- YOLO ---
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONFIDENCE=0.5

# --- Feed integrity thresholds (0.0 - 1.0) ---
STATICNESS_THRESHOLD=0.85
DUPLICATE_THRESHOLD=0.97
REPLAY_THRESHOLD=0.75

# --- Auth / replay protection ---
CHALLENGE_TTL_SECONDS=30
TOKEN_TTL_SECONDS=60

# --- Network IDS ---
PACKET_RATE_THRESHOLD=300
IDS_INTERFACE=
IDS_WINDOW_SECONDS=1

# --- Trust fusion weights (should sum to ~1.0) ---
CONTENT_WEIGHT=0.4
NETWORK_WEIGHT=0.3
FEED_WEIGHT=0.3

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO
